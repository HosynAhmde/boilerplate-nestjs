# ---- عمومی ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# آدرس فرانت برای CORS (چند مقدار با کاما)
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=pasha
POSTGRES_PASSWORD=pasha_dev_password
POSTGRES_DB=pasha_crm
DATABASE_URL=postgres://pasha:pasha_dev_password@localhost:5432/pasha_crm
DB_LOGGING=false

# ---- لاگ و مانیتورینگ ----
# سطح لاگ API (خالی = debug در توسعه، info در production)
LOG_LEVEL=
# اگر پر شود، /metrics فقط با هدر Authorization: Bearer <token> جواب می‌دهد
METRICS_TOKEN=
# رمز ورود Grafana (برای make monitoring-up الزامی)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# ---- Redis (صف BullMQ و محدودیت درخواست) ----
REDIS_URL=redis://localhost:6379

# ---- احراز هویت ----
# حداقل ۳۲ کاراکتر تصادفی؛ مثلاً: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# کلید HMAC برای هش کد OTP و توکن refresh
AUTH_HASH_PEPPER=change-me-too-change-me-too-change-me-too
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# در حالت development کد OTP در لاگ API چاپ می‌شود
OTP_DEV_LOG=true

# ---- پیامک ----
# console = فقط لاگ (توسعه). ارائه‌دهنده واقعی بعداً اضافه می‌شود.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=

# ---- ذخیره فایل ----
# local = دیسک سرور (پیش‌فرض) | s3 = هر فضای سازگار با S3 (مثل ابرآروان)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- کاربر مدیر اولیه (برای pnpm db:seed) ----
SEED_ADMIN_MOBILE=09120000000
SEED_ADMIN_FULL_NAME="مدیر سیستم"

# ---- فرانت ----
# آدرس API که Next.js درخواست‌های /api را به آن پاس می‌دهد
API_INTERNAL_URL=http://localhost:4000

# ---- سرور (فقط برای deploy) ----
# دامنه‌ای که به IP سرور اشاره می‌کند؛ Caddy برایش گواهی HTTPS می‌گیرد
DOMAIN=crm.example.ir
APP_VERSION=latest
# در سرورهای داخل ایران، این‌ها را به mirror داخلی تغییر دهید، مثلاً:
# NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine
# REDIS_IMAGE=docker.arvancloud.ir/redis:7-alpine
# CADDY_IMAGE=docker.arvancloud.ir/caddy:2-alpine
# PROMETHEUS_IMAGE / ALERTMANAGER_IMAGE / GRAFANA_IMAGE / LOKI_IMAGE / ALLOY_IMAGE
# NODE_EXPORTER_IMAGE / POSTGRES_EXPORTER_IMAGE / REDIS_EXPORTER_IMAGE هم به همین شکل
# NPM_REGISTRY=https://<npm-mirror>/
NODE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2-alpine
NPM_REGISTRY=https://registry.npmjs.org
# بکاپ: چند روز نگه داشته شود
BACKUP_KEEP_DAYS=14
